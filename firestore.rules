rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True only if the signed-in user has an admins document with isAdmin = true
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // A student can create and read only their own profile, and cannot
    // change their Student ID or email. Admins can read profiles.
    match /students/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // Used for the Student ID uniqueness check before sign-in.
    // Single lookups are allowed, listing all IDs is not.
    match /studentIds/{studentId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Students see and manage only their own bookings and cannot confirm them.
    // Admins can read, confirm and delete every booking.
    match /bookings/{id} {
      allow read: if signedIn() &&
        (resource.data.studentUid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.studentId ==
           get(/databases/$(database)/documents/students/$(request.auth.uid)).data.studentId;

      allow update: if signedIn() && (
        (resource.data.studentUid == request.auth.uid
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.status == resource.data.status)
        || isAdmin());

      allow delete: if signedIn() &&
        (resource.data.studentUid == request.auth.uid || isAdmin());
    }

    // Admin accounts. Creating one needs the correct access code from config/admin.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == true
        && request.resource.data.accessCode ==
           get(/databases/$(database)/documents/config/admin).data.code;
      allow update, delete: if false;
    }

    // The access code is private. No app can read or write it.
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}